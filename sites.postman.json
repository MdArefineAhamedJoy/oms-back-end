                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"<TENANT_ID>\",\n  \"name\": \"Changi Airport Terminal 1\",\n  \"siteCode\": \"SIN001\",\n  \"address\": \"Airport Boulevard, Singapore 819663\",\n  \"coordinates\": {\n    \"lat\": 1.3644,\n    \"lng\": 103.9915\n  },\n  \"geofenceRadius\": 500,\n  \"timezone\": \"Asia/Singapore\",\n  \"siteStatus\": \"ACTIVE\"\n}"
            },
            "url": {
              "baseURL": "http://localhost:3000",
              "path": ["api", "v1", "sites"]
            }
          }
        },
        {
