              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"<TENANT_ID>\",\n  \"name\": \"ABC Corporation\",\n  \"contactPerson\": \"John Doe\",\n  \"email\": \"contact@abc-corp.com\",\n  \"phone\": \"+65-6234-5678\",\n  \"address\": \"123 Business Park, Singapore\",\n  \"clientStatus\": \"ACTIVE\"\n}"
            },
            "url": {
              "baseURL": "http://localhost:3000",
              "path": ["api", "v1", "clients"]
            }
          }
        },
        {
